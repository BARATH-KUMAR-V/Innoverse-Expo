# =============================================================================
# INNOVERSE environment variables
# Copy this file to ".env.local" and fill in real values.
# NEVER commit the real ".env.local" file to GitHub.
# In production these are set once, in Vercel's Environment Variables screen -
# there is only one deployment now, so only one place to set them.
# =============================================================================

# ---- PostgreSQL (Supabase) --------------------------------------------------
# Use the "Transaction pooler" connection string from Supabase (Project
# Settings > Database) - NOT the "Direct connection" one. Route Handlers run
# as short-lived serverless functions, which is exactly what the pooler
# (port 6543) is designed for. Example shape:
# postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres

# ---- Google OAuth 2.0 --------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must exactly match an "Authorized redirect URI" in Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---- Access control -----------------------------------------------------------
# Only Google accounts on this domain may sign in.
ALLOWED_EMAIL_DOMAIN=nec.edu.in

# Comma-separated list of admin emails (must also be on ALLOWED_EMAIL_DOMAIN).
ADMIN_EMAILS=admin1@nec.edu.in,admin2@nec.edu.in

# ---- Supabase Storage ---------------------------------------------------------
# Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
# The SERVICE ROLE key (secret, server-side only - never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_IMAGE_BUCKET=product-images
SUPABASE_VIDEO_BUCKET=product-videos

# Public (safe to expose) - used only by the browser to upload files directly
# to Storage via a signed URL. Project Settings > API > Project URL / anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- Event schedule -----------------------------------------------------------
# The expo date/venue, voting start/close time, and winner-announcement time
# are NOT environment variables - they live in the `event_settings` table and
# are editable from Admin -> Event Settings once signed in. See db/schema.sql
# for the seeded defaults you'll want to replace before the real event.
