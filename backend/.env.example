# =============================================================================
# INNOVERSE backend environment variables
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to GitHub.
# =============================================================================

# ---- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Public URL of the DEPLOYED frontend (used for CORS + post-login redirects).
# Local dev example is fine as-is. In production, use your Vercel URL, e.g.
# https://innoverse-expo.vercel.app  (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ---- PostgreSQL (Supabase) --------------------------------------------------
# Use the "Direct connection" string from Supabase (Project Settings > Database),
# NOT the "Transaction pooler" one - this server keeps a long-lived connection
# pool, which the direct connection is designed for. Example shape:
# postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:Barath%40201044@db.zlghgjohuehfrsshztgf.supabase.co:5432/postgres

# ---- Sessions ----------------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# ---- Google OAuth 2.0 --------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must exactly match an "Authorized redirect URI" in Google Cloud Console.
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---- Access control -----------------------------------------------------------
# Only Google accounts on this domain may sign in.
ALLOWED_EMAIL_DOMAIN=nec.edu.in

# Comma-separated list of admin emails (must also be on ALLOWED_EMAIL_DOMAIN).
ADMIN_EMAILS=admin1@nec.edu.in,admin2@nec.edu.in

# ---- Supabase Storage ---------------------------------------------------------
# Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://zlghgjohuehfrsshztgf.supabase.co
# The SERVICE ROLE key (secret, server-side only - never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_IMAGE_BUCKET=product-images
SUPABASE_VIDEO_BUCKET=product-videos

# ---- Optional automatic voting close-off --------------------------------------
# If set, a background job checks every minute and automatically flips voting
# to CLOSED once this instant passes (in addition to the admin's manual
# "Stop Voting" button). Use a full ISO-8601 timestamp with the +05:30 (IST)
# offset so it does not depend on server or browser local time.
# Leave blank to disable and rely solely on the admin's manual control.
VOTING_AUTO_CLOSE_AT=2026-09-05T13:30:00+05:30
