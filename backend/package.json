{
  "name": "innoverse-backend",
  "version": "1.0.0",
  "private": true,
  "description": "INNOVERSE - Prompt to Product Expo | Express + PostgreSQL (Supabase) voting API",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
